{
  "name": "remove-background-webgpu",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "manifest": "node scripts/gen-model-manifest.mjs",
    "fonts": "node scripts/vendor-fonts.mjs",
    "predev": "npm run manifest",
    "dev": "vite",
    "prebuild": "npm run manifest",
    "build": "vite build && node scripts/prerender.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "preview": "vite preview",
    "pages:dev": "npm run build && wrangler pages dev dist",
    "pages:deploy": "npm run build && rm -f dist/models/briaai/RMBG-1.4/onnx/model_quantized.onnx && wrangler pages deploy dist --branch main"
  },
  "dependencies": {
    "@huggingface/transformers": "3.0.0-alpha.15",
    "onnxruntime-web": "^1.20.0-dev.20240908-de7a02beef",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.10.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/spline-sans": "^5.3.0",
    "@fontsource/spline-sans-mono": "^5.3.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.10.0",
    "eslint-plugin-react": "^7.35.2",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.9.3",
    "vite": "^5.4.3"
  }
}
